{
  "name": "kataoke",
  "version": "0.0.1",
  "private": true,
  "description": "Караоке-тексты поверх любого музыкального сервиса в браузере",
  "type": "module",
  "scripts": {
    "dev": "vite build --mode content --watch",
    "build": "npm run build:content && npm run build:page-agent && npm run build:background",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "build:content": "vite build --mode content",
    "build:background": "vite build --mode background",
    "build:page-agent": "vite build --mode page-agent"
  },
  "dependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
