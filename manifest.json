{
  "manifest_version": 3,
  "name": "kataoke",
  "version": "0.0.1",
  "description": "Караоке-тексты поверх любого музыкального сервиса",
  "default_locale": "ru",
  "action": {
    "default_title": "kataoke",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://music.yandex.ru/*", "https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://lrclib.net/*"],
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
