{
  "manifest_version": 3,
  "name": "kataoke",
  "version": "0.0.1",
  "description": "Караоке-тексты поверх любого музыкального сервиса",
  "action": {
    "default_title": "kataoke"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://music.yandex.kz/*",
        "https://music.yandex.by/*",
        "https://music.yandex.uz/*",
        "https://www.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://lrclib.net/*"],
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
